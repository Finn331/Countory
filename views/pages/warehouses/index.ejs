<div class="space-y-6">
  <!-- Header -->
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <div>
      <h1 class="text-2xl font-bold text-slate-900">Gudang</h1>
      <p class="text-slate-600">Kelola gudang dan stok</p>
    </div>
    <button onclick="openModal('addWarehouse')" class="inline-flex items-center gap-2 px-4 py-2 bg-primary-500 text-white font-semibold rounded-xl hover:bg-primary-600 transition-colors">
      <i data-lucide="plus" class="w-5 h-5"></i>
      Tambah Gudang
    </button>
  </div>

  <!-- Warehouses Grid -->
  <div id="warehousesGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
    <div class="bg-white rounded-xl border border-slate-100 p-6 text-center">
      <div class="flex flex-col items-center">
        <div class="w-8 h-8 border-4 border-primary-500 border-t-transparent rounded-full animate-spin mb-4"></div>
        <p class="text-slate-500">Memuat data...</p>
      </div>
    </div>
  </div>
</div>

<!-- Add Warehouse Modal -->
<div id="addWarehouseModal" class="fixed inset-0 bg-black/50 z-50 hidden items-center justify-center p-4">
  <div class="bg-white rounded-2xl w-full max-w-md">
    <div class="p-6 border-b border-slate-100">
      <div class="flex items-center justify-between">
        <h2 class="text-xl font-bold text-slate-900">Tambah Gudang</h2>
        <button onclick="closeModal('addWarehouse')" class="p-2 hover:bg-slate-100 rounded-lg transition-colors">
          <i data-lucide="x" class="w-5 h-5"></i>
        </button>
      </div>
    </div>
    <form id="addWarehouseForm" class="p-6 space-y-4">
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1">Nama Gudang *</label>
        <input type="text" name="name" required class="w-full px-4 py-2 border border-slate-200 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500">
      </div>
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1">Kode *</label>
        <input type="text" name="code" required class="w-full px-4 py-2 border border-slate-200 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 uppercase">
      </div>
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1">Alamat</label>
        <textarea name="address" rows="2" class="w-full px-4 py-2 border border-slate-200 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500"></textarea>
      </div>
      <div class="flex gap-3 pt-4">
        <button type="button" onclick="closeModal('addWarehouse')" class="flex-1 px-4 py-2 border border-slate-200 text-slate-700 font-medium rounded-lg hover:bg-slate-50 transition-colors">Batal</button>
        <button type="submit" class="flex-1 px-4 py-2 bg-primary-500 text-white font-medium rounded-lg hover:bg-primary-600 transition-colors">Simpan</button>
      </div>
    </form>
  </div>
</div>

<!-- Edit Warehouse Modal -->
<div id="editWarehouseModal" class="fixed inset-0 bg-black/50 z-50 hidden items-center justify-center p-4">
  <div class="bg-white rounded-2xl w-full max-w-md">
    <div class="p-6 border-b border-slate-100">
      <div class="flex items-center justify-between">
        <h2 class="text-xl font-bold text-slate-900">Edit Gudang</h2>
        <button onclick="closeModal('editWarehouse')" class="p-2 hover:bg-slate-100 rounded-lg transition-colors">
          <i data-lucide="x" class="w-5 h-5"></i>
        </button>
      </div>
    </div>
    <form id="editWarehouseForm" class="p-6 space-y-4">
      <input type="hidden" name="id">
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1">Nama Gudang *</label>
        <input type="text" name="name" required class="w-full px-4 py-2 border border-slate-200 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500">
      </div>
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1">Kode *</label>
        <input type="text" name="code" required class="w-full px-4 py-2 border border-slate-200 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 uppercase">
      </div>
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1">Alamat</label>
        <textarea name="address" rows="2" class="w-full px-4 py-2 border border-slate-200 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500"></textarea>
      </div>
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1">Status</label>
        <select name="status" class="w-full px-4 py-2 border border-slate-200 rounded-lg focus:ring-2 focus:ring-primary-500">
          <option value="active">Aktif</option>
          <option value="inactive">Nonaktif</option>
        </select>
      </div>
      <div class="flex gap-3 pt-4">
        <button type="button" onclick="closeModal('editWarehouse')" class="flex-1 px-4 py-2 border border-slate-200 text-slate-700 font-medium rounded-lg hover:bg-slate-50 transition-colors">Batal</button>
        <button type="submit" class="flex-1 px-4 py-2 bg-primary-500 text-white font-medium rounded-lg hover:bg-primary-600 transition-colors">Update</button>
      </div>
    </form>
  </div>
</div>

<script>
async function loadWarehouses() {
  try {
    const res = await api.get('/api/warehouses');
    renderWarehouses(res.warehouses);
  } catch (err) {
    showToast('Gagal memuat data gudang', 'error');
  }
}

function renderWarehouses(warehouses) {
  const grid = document.getElementById('warehousesGrid');
  if (!warehouses.length) {
    grid.innerHTML = `
      <div class="col-span-full bg-white rounded-xl border border-slate-100 p-12 text-center">
        <i data-lucide="warehouse" class="w-12 h-12 text-slate-300 mx-auto mb-4"></i>
        <p class="text-slate-500">Belum ada gudang</p>
        <button onclick="openModal('addWarehouse')" class="mt-4 text-primary-500 font-medium hover:text-primary-600">Tambah Gudang</button>
      </div>`;
    lucide.createIcons();
    return;
  }

  grid.innerHTML = warehouses.map(w => `
    <div class="gsap-reveal bg-white rounded-xl border border-slate-100 p-6 card-hover">
      <div class="flex items-start justify-between mb-4">
        <div class="w-12 h-12 bg-green-100 rounded-xl flex items-center justify-center">
          <i data-lucide="warehouse" class="w-6 h-6 text-green-600"></i>
        </div>
        <div class="flex gap-2">
          <button onclick="editWarehouse(${w.id})" class="p-2 hover:bg-slate-100 rounded-lg transition-colors">
            <i data-lucide="pencil" class="w-4 h-4 text-slate-600"></i>
          </button>
          <button onclick="deleteWarehouse(${w.id})" class="p-2 hover:bg-red-50 rounded-lg transition-colors">
            <i data-lucide="trash-2" class="w-4 h-4 text-red-500"></i>
          </button>
        </div>
      </div>
      <h3 class="font-bold text-slate-900 mb-1">${w.name}</h3>
      <p class="text-sm text-slate-500 mb-3">${w.address || '-'}</p>
      <div class="flex items-center justify-between">
        <span class="text-xs font-mono bg-slate-100 px-2 py-1 rounded">${w.code}</span>
        <div class="text-right">
          <p class="text-lg font-bold text-slate-900">${w.totalProducts}</p>
          <p class="text-xs text-slate-500">produk</p>
        </div>
      </div>
    </div>
  `).join('');
  lucide.createIcons();
}

function openModal(type) {
  document.getElementById(`${type}Modal`).classList.remove('hidden');
  document.getElementById(`${type}Modal`).classList.add('flex');
}

function closeModal(type) {
  document.getElementById(`${type}Modal`).classList.add('hidden');
  document.getElementById(`${type}Modal`).classList.remove('flex');
  document.getElementById(`${type}Form`).reset();
}

async function editWarehouse(id) {
  try {
    const res = await api.get(`/api/warehouses/${id}`);
    const w = res.warehouse;
    const form = document.getElementById('editWarehouseForm');
    form.querySelector('[name="id"]').value = w.id;
    form.querySelector('[name="name"]').value = w.name;
    form.querySelector('[name="code"]').value = w.code;
    form.querySelector('[name="address"]').value = w.address || '';
    form.querySelector('[name="status"]').value = w.status;
    openModal('editWarehouse');
  } catch (err) {
    showToast('Gagal memuat data gudang', 'error');
  }
}

async function deleteWarehouse(id) {
  if (!confirm('Yakin ingin menghapus gudang ini?')) return;
  try {
    await api.delete(`/api/warehouses/${id}`);
    showToast('Gudang berhasil dihapus', 'success');
    loadWarehouses();
  } catch (err) {
    showToast(err.message || 'Gagal menghapus gudang', 'error');
  }
}

document.getElementById('addWarehouseForm').addEventListener('submit', async (e) => {
  e.preventDefault();
  const formData = new FormData(e.target);
  const data = Object.fromEntries(formData);
  try {
    await api.post('/api/warehouses', data);
    showToast('Gudang berhasil ditambahkan', 'success');
    closeModal('addWarehouse');
    loadWarehouses();
  } catch (err) {
    showToast(err.message || 'Gagal menambahkan gudang', 'error');
  }
});

document.getElementById('editWarehouseForm').addEventListener('submit', async (e) => {
  e.preventDefault();
  const formData = new FormData(e.target);
  const data = Object.fromEntries(formData);
  const id = data.id;
  delete data.id;
  try {
    await api.put(`/api/warehouses/${id}`, data);
    showToast('Gudang berhasil diperbarui', 'success');
    closeModal('editWarehouse');
    loadWarehouses();
  } catch (err) {
    showToast(err.message || 'Gagal memperbarui gudang', 'error');
  }
});

loadWarehouses();
</script>
