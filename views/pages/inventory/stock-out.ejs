<div class="space-y-6">
  <!-- Header -->
  <div>
    <h1 class="text-2xl font-bold text-slate-900">Stok Keluar</h1>
    <p class="text-slate-600">Catat barang keluar dari gudang</p>
  </div>

  <!-- Form -->
  <div class="bg-white rounded-xl border border-slate-100 p-6">
    <form id="stockOutForm" class="space-y-4">
      <div class="grid md:grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1">Produk *</label>
          <select name="productId" required class="w-full px-4 py-2 border border-slate-200 rounded-lg focus:ring-2 focus:ring-primary-500">
            <option value="">Pilih produk...</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1">Gudang *</label>
          <select name="warehouseId" required class="w-full px-4 py-2 border border-slate-200 rounded-lg focus:ring-2 focus:ring-primary-500">
            <option value="">Pilih gudang...</option>
          </select>
        </div>
      </div>

      <div class="grid md:grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1">Jumlah *</label>
          <input type="number" name="quantity" min="1" required class="w-full px-4 py-2 border border-slate-200 rounded-lg focus:ring-2 focus:ring-primary-500" placeholder="Masukkan jumlah">
          <p id="stockInfo" class="text-sm text-slate-500 mt-1">Stok tersedia: <span id="availableStock">-</span></p>
        </div>
        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1">Referensi</label>
          <input type="text" name="referenceNumber" class="w-full px-4 py-2 border border-slate-200 rounded-lg focus:ring-2 focus:ring-primary-500" placeholder="Nomor referensi (opsional)">
        </div>
      </div>

      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1">Catatan</label>
        <textarea name="notes" rows="2" class="w-full px-4 py-2 border border-slate-200 rounded-lg focus:ring-2 focus:ring-primary-500" placeholder="Catatan tambahan (opsional)"></textarea>
      </div>

      <div class="flex gap-3 pt-4">
        <button type="submit" class="px-6 py-3 bg-red-500 text-white font-semibold rounded-xl hover:bg-red-600 transition-colors">
          <i data-lucide="package-minus" class="w-5 h-5 inline mr-2"></i>
          Simpan Stok Keluar
        </button>
      </div>
    </form>
  </div>

  <!-- Recent Movements -->
  <div class="bg-white rounded-xl border border-slate-100">
    <div class="px-6 py-4 border-b border-slate-100">
      <h2 class="font-bold text-slate-900">Riwayat Stok Keluar</h2>
    </div>
    <div class="p-6">
      <div id="recentMovements" class="text-center py-8">
        <i data-lucide="inbox" class="w-12 h-12 text-slate-300 mx-auto mb-4"></i>
        <p class="text-slate-500">Memuat data...</p>
      </div>
    </div>
  </div>
</div>

<script>
async function init() {
  await Promise.all([loadProducts(), loadWarehouses()]);
  loadRecentMovements();
}

async function loadProducts() {
  try {
    const res = await api.get('/api/products?limit=100');
    const select = document.querySelector('[name="productId"]');
    select.innerHTML = '<option value="">Pilih produk...</option>' +
      res.products.map(p => `<option value="${p.id}">${p.name} (${p.sku})</option>`).join('');
  } catch (err) {
    console.error('Load products error:', err);
  }
}

async function loadWarehouses() {
  try {
    const res = await api.get('/api/warehouses');
    const select = document.querySelector('[name="warehouseId"]');
    select.innerHTML = '<option value="">Pilih gudang...</option>' +
      res.warehouses.map(w => `<option value="${w.id}">${w.name}</option>`).join('');
  } catch (err) {
    console.error('Load warehouses error:', err);
  }
}

async function loadRecentMovements() {
  try {
    const res = await api.get('/api/inventory/movements?limit=10&movementType=stock_out');
    renderMovements(res.movements);
  } catch (err) {
    console.error('Load movements error:', err);
  }
}

function renderMovements(movements) {
  const container = document.getElementById('recentMovements');
  if (!movements.length) {
    container.innerHTML = `
      <div class="text-center py-8">
        <i data-lucide="inbox" class="w-12 h-12 text-slate-300 mx-auto mb-4"></i>
        <p class="text-slate-500">Belum ada riwayat stok keluar</p>
      </div>`;
    lucide.createIcons();
    return;
  }

  container.innerHTML = `
    <div class="space-y-3">
      ${movements.map(m => `
        <div class="flex items-center justify-between p-3 bg-slate-50 rounded-lg">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-red-100 rounded-lg flex items-center justify-center">
              <i data-lucide="arrow-up-right" class="w-5 h-5 text-red-600"></i>
            </div>
            <div>
              <p class="font-medium text-slate-900">${m.product.name}</p>
              <p class="text-xs text-slate-500">${m.warehouse.name} • ${new Date(m.createdAt).toLocaleString('id-ID')}</p>
            </div>
          </div>
          <div class="text-right">
            <p class="font-bold text-red-600">-${m.quantity}</p>
            <p class="text-xs text-slate-500">stok: ${m.currentStock}</p>
          </div>
        </div>
      `).join('')}
    </div>`;
  lucide.createIcons();
}

document.getElementById('stockOutForm').addEventListener('submit', async (e) => {
  e.preventDefault();
  const formData = new FormData(e.target);
  const data = Object.fromEntries(formData);

  try {
    await api.post('/api/inventory/stock-out', data);
    showToast('Stok keluar berhasil dicatat', 'success');
    e.target.reset();
    loadRecentMovements();
  } catch (err) {
    showToast(err.message || 'Gagal mencatat stok keluar', 'error');
  }
});

init();
</script>
