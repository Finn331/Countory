<div class="min-h-screen flex items-center justify-center bg-gradient-to-br from-primary-50 via-white to-accent-50 py-12 px-4 sm:px-6 lg:px-8 relative overflow-hidden">
  <!-- Decorative Background Elements -->
  <div class="absolute top-10 left-10 w-72 h-72 bg-primary-200/30 rounded-full blur-3xl animate-float"></div>
  <div class="absolute bottom-10 right-10 w-96 h-96 bg-accent-200/30 rounded-full blur-3xl animate-float" style="animation-delay: 1.5s"></div>

  <div class="max-w-md w-full space-y-8 glass p-8 sm:p-10 rounded-3xl shadow-2xl relative z-10 animate-scale-in">
    <div>
      <a href="/" class="flex justify-center items-center gap-3 mb-6">
        <div class="w-12 h-12 bg-gradient-to-br from-primary-500 to-accent-500 rounded-2xl flex items-center justify-center shadow-lg shadow-primary-500/30">
          <span class="text-white font-bold text-2xl">C</span>
        </div>
      </a>
      <h2 class="text-center text-3xl font-bold text-slate-900">
        Selamat Datang Kembali
      </h2>
      <p class="mt-2 text-center text-sm text-slate-600">
        Masuk ke akun Countory Anda untuk mengelola inventaris
      </p>
    </div>

    <form id="loginForm" class="mt-8 space-y-6">
      <div class="space-y-4">
        <div>
          <label for="email" class="block text-sm font-medium text-slate-700 mb-1">Email</label>
          <div class="relative">
            <i data-lucide="mail" class="absolute left-3 top-1/2 -translate-y-1/2 w-5 h-5 text-slate-400"></i>
            <input id="email" name="email" type="email" required autocomplete="email" placeholder="nama@perusahaan.com"
              class="w-full pl-10 pr-4 py-3 bg-white/60 border border-slate-200 rounded-xl text-sm focus:ring-2 focus:ring-primary-500 focus:border-primary-500 transition-all">
          </div>
        </div>

        <div>
          <div class="flex justify-between items-center mb-1">
            <label for="password" class="block text-sm font-medium text-slate-700">Password</label>
            <a href="/forgot-password" class="text-xs font-semibold text-primary-600 hover:text-primary-500 transition-colors">Lupa Password?</a>
          </div>
          <div class="relative">
            <i data-lucide="lock" class="absolute left-3 top-1/2 -translate-y-1/2 w-5 h-5 text-slate-400"></i>
            <input id="password" name="password" type="password" required autocomplete="current-password" placeholder="••••••••"
              class="w-full pl-10 pr-4 py-3 bg-white/60 border border-slate-200 rounded-xl text-sm focus:ring-2 focus:ring-primary-500 focus:border-primary-500 transition-all">
          </div>
        </div>
      </div>

      <div>
        <button type="submit"
          class="w-full flex justify-center items-center gap-2 py-3.5 px-4 bg-gradient-to-r from-primary-500 to-accent-500 text-white font-semibold rounded-xl shadow-lg shadow-primary-500/30 hover:shadow-xl hover:shadow-primary-500/40 transition-all btn-shine">
          <span>Masuk</span>
          <i data-lucide="arrow-right" class="w-5 h-5"></i>
        </button>
      </div>

      <div class="text-center pt-2">
        <p class="text-sm text-slate-600">
          Belum punya akun?
          <a href="/register" class="font-semibold text-primary-600 hover:text-primary-500 transition-colors">
            Daftar Sekarang
          </a>
        </p>
      </div>
    </form>
  </div>
</div>

<script>
document.getElementById('loginForm').addEventListener('submit', async (e) => {
  e.preventDefault();
  const formData = new FormData(e.target);
  const data = Object.fromEntries(formData);
  
  showLoading();
  try {
    const res = await api.post('/api/auth/login', data);
    showToast('Login berhasil! Mengalihkan...', 'success');
    setTimeout(() => {
      window.location.href = '/dashboard';
    }, 1000);
  } catch (err) {
    hideLoading();
    showToast(err.message || 'Email atau password salah', 'error');
  }
});
</script>
