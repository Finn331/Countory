<div class="min-h-screen flex items-center justify-center bg-gradient-to-br from-primary-50 via-white to-accent-50 py-12 px-4 sm:px-6 lg:px-8 relative overflow-hidden">
  <!-- Decorative Background Elements -->
  <div class="absolute top-10 right-10 w-72 h-72 bg-primary-200/30 rounded-full blur-3xl animate-float"></div>
  <div class="absolute bottom-10 left-10 w-96 h-96 bg-accent-200/30 rounded-full blur-3xl animate-float" style="animation-delay: 1.5s"></div>

  <div class="max-w-md w-full space-y-8 glass p-8 sm:p-10 rounded-3xl shadow-2xl relative z-10 animate-scale-in">
    <div>
      <a href="/" class="flex justify-center items-center gap-3 mb-6">
        <div class="w-12 h-12 bg-gradient-to-br from-primary-500 to-accent-500 rounded-2xl flex items-center justify-center shadow-lg shadow-primary-500/30">
          <span class="text-white font-bold text-2xl">C</span>
        </div>
      </a>
      <h2 class="text-center text-3xl font-bold text-slate-900">
        Buat Password Baru
      </h2>
      <p class="mt-2 text-center text-sm text-slate-600">
        Masukkan kata sandi baru untuk akun Anda
      </p>
    </div>

    <form id="resetForm" class="mt-8 space-y-6">
      <div class="space-y-4">
        <div>
          <label for="newPassword" class="block text-sm font-medium text-slate-700 mb-1">Password Baru *</label>
          <div class="relative">
            <i data-lucide="lock" class="absolute left-3 top-1/2 -translate-y-1/2 w-5 h-5 text-slate-400"></i>
            <input id="newPassword" name="password" type="password" required placeholder="Min. 8 karakter"
              class="w-full pl-10 pr-4 py-3 bg-white/60 border border-slate-200 rounded-xl text-sm focus:ring-2 focus:ring-primary-500 focus:border-primary-500 transition-all">
          </div>
        </div>

        <div>
          <label for="confirmPassword" class="block text-sm font-medium text-slate-700 mb-1">Konfirmasi Password Baru *</label>
          <div class="relative">
            <i data-lucide="check-circle" class="absolute left-3 top-1/2 -translate-y-1/2 w-5 h-5 text-slate-400"></i>
            <input id="confirmPassword" name="confirmPassword" type="password" required placeholder="Ulangi password baru"
              class="w-full pl-10 pr-4 py-3 bg-white/60 border border-slate-200 rounded-xl text-sm focus:ring-2 focus:ring-primary-500 focus:border-primary-500 transition-all">
          </div>
        </div>
      </div>

      <div>
        <button type="submit"
          class="w-full flex justify-center items-center gap-2 py-3.5 px-4 bg-gradient-to-r from-primary-500 to-accent-500 text-white font-semibold rounded-xl shadow-lg shadow-primary-500/30 hover:shadow-xl hover:shadow-primary-500/40 transition-all btn-shine">
          <span>Simpan Password Baru</span>
          <i data-lucide="check" class="w-5 h-5"></i>
        </button>
      </div>

      <div class="text-center pt-2">
        <a href="/login" class="text-sm font-semibold text-slate-600 hover:text-primary-600 transition-colors">
          &larr; Batal & Kembali ke Login
        </a>
      </div>
    </form>
  </div>
</div>

<script>
document.getElementById('resetForm').addEventListener('submit', (e) => {
  e.preventDefault();
  const pass = document.getElementById('newPassword').value;
  const conf = document.getElementById('confirmPassword').value;

  if (pass !== conf) {
    showToast('Konfirmasi password tidak cocok!', 'error');
    return;
  }
  if (pass.length < 8) {
    showToast('Password minimal 8 karakter!', 'error');
    return;
  }

  showLoading();
  setTimeout(() => {
    hideLoading();
    showToast('Password berhasil diubah! Mengalihkan ke login...', 'success');
    setTimeout(() => {
      window.location.href = '/login';
    }, 1200);
  }, 800);
});
</script>
