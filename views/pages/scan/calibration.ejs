<div class="space-y-6">
  <!-- Header -->
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <div>
      <h1 class="text-2xl font-bold text-slate-900">Kalibrasi Deteksi AI (OpenCV)</h1>
      <p class="text-slate-600">Atur sensitivitas, ambang batas, dan ukuran area deteksi untuk akurasi maksimal per produk</p>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- Left Column: Product Selector & Profiles List -->
    <div class="space-y-6">
      <div class="bg-white rounded-2xl border border-slate-100 p-6 space-y-4 shadow-sm">
        <label class="block text-sm font-bold text-slate-800">1. Pilih Produk yang Akan Dikalibrasi</label>
        <select id="productSelect" class="w-full px-4 py-3 border border-slate-200 rounded-xl bg-slate-50 font-semibold text-sm focus:ring-2 focus:ring-primary-500" onchange="onProductSelected()">
          <option value="">Pilih Produk...</option>
        </select>
      </div>

      <div class="bg-white rounded-2xl border border-slate-100 p-6 space-y-4 shadow-sm">
        <div class="flex items-center justify-between">
          <h3 class="font-bold text-sm text-slate-800">Daftar Profil Tersimpan</h3>
          <button onclick="createNewProfileForm()" id="newProfileBtn" class="px-3 py-1 bg-primary-50 text-primary-600 hover:bg-primary-500 hover:text-white rounded-lg text-xs font-bold transition-all disabled:opacity-50" disabled>
            + Buat Profil Baru
          </button>
        </div>
        <div id="profilesListContainer" class="space-y-2 max-h-80 overflow-y-auto">
          <p class="text-xs text-slate-400 text-center py-8">Pilih produk untuk melihat profil deteksi.</p>
        </div>
      </div>
    </div>

    <!-- Right Column: Calibration Parameters Form & Simulation -->
    <div class="lg:col-span-2">
      <div id="calibrationFormCard" class="bg-white rounded-2xl border border-slate-100 p-6 sm:p-8 space-y-6 shadow-sm opacity-50 pointer-events-none transition-all">
        <div class="flex items-center justify-between border-b border-slate-100 pb-4">
          <div>
            <h2 class="text-lg font-bold text-slate-900" id="formTitle">Parameter Kalibrasi</h2>
            <p class="text-xs text-slate-500">Sesuaikan slider untuk mengubah sensitivitas computer vision</p>
          </div>
          <span id="activeStatusBadge" class="hidden px-3 py-1 bg-green-100 text-green-700 font-bold text-xs rounded-full">PROFIL AKTIF</span>
        </div>

        <form id="profileForm" class="space-y-6">
          <input type="hidden" id="profileId" name="id">
          <input type="hidden" id="selectedProductId" name="productId">

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-bold text-slate-700 mb-1">Nama Profil *</label>
              <input type="text" name="name" id="paramName" required placeholder="Misal: Kalibrasi Cahaya Terang" class="w-full px-3 py-2 border border-slate-200 rounded-lg text-sm bg-slate-50 focus:ring-2 focus:ring-primary-500">
            </div>
            <div>
              <label class="block text-xs font-bold text-slate-700 mb-1">Mode Deteksi</label>
              <select name="detectionType" id="paramDetectionType" class="w-full px-3 py-2 border border-slate-200 rounded-lg text-sm bg-slate-50 focus:ring-2 focus:ring-primary-500">
                <option value="contour">Contour Analysis (Default - Sangat Akurat)</option>
                <option value="color">Color Filter HSV</option>
                <option value="binary">Binary Threshold</option>
              </select>
            </div>
          </div>

          <!-- Slider Controls -->
          <div class="space-y-5 bg-slate-50 p-5 rounded-2xl border border-slate-200/80">
            <div>
              <div class="flex justify-between items-center text-xs font-bold mb-1">
                <span class="text-slate-700">Minimum Area (px²) — Abaikan debu/noise kecil</span>
                <span id="valMinArea" class="font-mono text-primary-600 bg-white px-2 py-0.5 rounded border border-slate-200">500 px²</span>
              </div>
              <input type="range" name="minArea" id="paramMinArea" min="50" max="10000" step="50" value="500" class="w-full accent-primary-500" oninput="updateSliderDisplay()">
            </div>

            <div>
              <div class="flex justify-between items-center text-xs font-bold mb-1">
                <span class="text-slate-700">Maksimum Area (px²) — Abaikan latar belakang besar</span>
                <span id="valMaxArea" class="font-mono text-primary-600 bg-white px-2 py-0.5 rounded border border-slate-200">100000 px²</span>
              </div>
              <input type="range" name="maxArea" id="paramMaxArea" min="5000" max="300000" step="5000" value="100000" class="w-full accent-primary-500" oninput="updateSliderDisplay()">
            </div>

            <div>
              <div class="flex justify-between items-center text-xs font-bold mb-1">
                <span class="text-slate-700">Threshold Value (Ambang Batas Biner 0 - 255)</span>
                <span id="valThreshold" class="font-mono text-primary-600 bg-white px-2 py-0.5 rounded border border-slate-200">128</span>
              </div>
              <input type="range" name="thresholdValue" id="paramThreshold" min="10" max="240" step="2" value="128" class="w-full accent-primary-500" oninput="updateSliderDisplay()">
            </div>

            <div>
              <div class="flex justify-between items-center text-xs font-bold mb-1">
                <span class="text-slate-700">Gaussian Blur Kernel Size (Kehalusan kontur)</span>
                <span id="valBlur" class="font-mono text-primary-600 bg-white px-2 py-0.5 rounded border border-slate-200">5 (Normal)</span>
              </div>
              <select name="blurKernel" id="paramBlur" class="w-full px-3 py-1.5 border border-slate-200 rounded-lg text-xs bg-white font-mono" onchange="updateSliderDisplay()">
                <option value="1">1 (Tanpa Blur - Tajam)</option>
                <option value="3">3 (Halus Ringan)</option>
                <option value="5" selected>5 (Normal - Direkomendasikan)</option>
                <option value="7">7 (Halus Sedang)</option>
                <option value="9">9 (Halus Tinggi - Untuk pencahayaan gelap)</option>
              </select>
            </div>
          </div>

          <!-- Action Buttons -->
          <div class="flex items-center justify-between pt-2 border-t border-slate-100">
            <div class="flex gap-2" id="profileActionBtns">
              <button type="button" onclick="activateCurrentProfile()" id="activateBtn" class="hidden px-4 py-2.5 bg-green-500 hover:bg-green-600 text-white font-bold text-xs rounded-xl transition-colors">
                <i data-lucide="check-circle" class="w-4 h-4 inline mr-1"></i> Jadikan Profil Aktif
              </button>
              <button type="button" onclick="deleteCurrentProfile()" id="deleteProfileBtn" class="hidden px-3 py-2.5 bg-red-50 hover:bg-red-500 hover:text-white text-red-600 font-bold text-xs rounded-xl transition-colors">
                Hapus
              </button>
            </div>
            <button type="submit" class="px-6 py-2.5 bg-gradient-to-r from-primary-500 to-accent-500 text-white font-bold text-sm rounded-xl shadow-lg shadow-primary-500/30 hover:shadow-xl transition-all">
              Simpan Profil Kalibrasi
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<script>
let productsList = [];
let currentProfiles = [];
let selectedProfileId = null;

async function init() {
  await loadProducts();
}

async function loadProducts() {
  try {
    const res = await api.get('/api/products?limit=100');
    productsList = res.products || [];
    const opts = productsList.map(p => `<option value="${p.id}">${p.name} (${p.sku})</option>`).join('');
    document.getElementById('productSelect').innerHTML = '<option value="">Pilih Produk...</option>' + opts;
  } catch (err) {
    console.error('Failed to load products:', err);
  }
}

function updateSliderDisplay() {
  document.getElementById('valMinArea').textContent = `${document.getElementById('paramMinArea').value} px²`;
  document.getElementById('valMaxArea').textContent = `${document.getElementById('paramMaxArea').value} px²`;
  document.getElementById('valThreshold').textContent = document.getElementById('paramThreshold').value;
  const blurVal = document.getElementById('paramBlur').value;
  document.getElementById('valBlur').textContent = `${blurVal} ${blurVal === '5' ? '(Normal)' : ''}`;
}

async function onProductSelected() {
  const prodId = document.getElementById('productSelect').value;
  const newBtn = document.getElementById('newProfileBtn');
  const card = document.getElementById('calibrationFormCard');

  if (!prodId) {
    newBtn.disabled = true;
    card.classList.add('opacity-50', 'pointer-events-none');
    document.getElementById('profilesListContainer').innerHTML = '<p class="text-xs text-slate-400 text-center py-8">Pilih produk untuk melihat profil deteksi.</p>';
    return;
  }

  newBtn.disabled = false;
  card.classList.remove('opacity-50', 'pointer-events-none');
  document.getElementById('selectedProductId').value = prodId;

  await loadProfilesForProduct(prodId);
}

async function loadProfilesForProduct(productId) {
  try {
    const res = await api.get(`/api/products/${productId}/detection-profiles`);
    currentProfiles = res.profiles || [];
    renderProfilesList();
    
    // Auto select active or first profile
    const active = currentProfiles.find(p => p.isActive) || currentProfiles[0];
    if (active) {
      selectProfile(active.id);
    } else {
      createNewProfileForm();
    }
  } catch (err) {
    showToast('Gagal memuat profil deteksi', 'error');
  }
}

function renderProfilesList() {
  const container = document.getElementById('profilesListContainer');
  if (!currentProfiles.length) {
    container.innerHTML = '<p class="text-xs text-slate-400 text-center py-6 bg-slate-50 rounded-xl">Belum ada profil kalibrasi untuk produk ini.</p>';
    return;
  }

  container.innerHTML = currentProfiles.map(p => `
    <div onclick="selectProfile(${p.id})" class="p-3 rounded-xl border transition-all cursor-pointer flex items-center justify-between ${p.id === selectedProfileId ? 'border-primary-500 bg-primary-50/50 shadow-sm' : 'border-slate-200 hover:bg-slate-50 bg-white'}">
      <div>
        <div class="flex items-center gap-1.5">
          <span class="font-bold text-sm text-slate-900">${p.name}</span>
          ${p.isActive ? '<span class="w-2 h-2 bg-green-500 rounded-full" title="Profil Aktif"></span>' : ''}
        </div>
        <p class="text-[10px] text-slate-500 font-mono mt-0.5">Thresh: ${p.thresholdValue} | Blur: ${p.blurKernel} | Min: ${p.minArea}</p>
      </div>
      <span class="text-[10px] font-mono px-1.5 py-0.5 bg-slate-100 rounded text-slate-600">v${p.version}</span>
    </div>
  `).join('');
}

function selectProfile(id) {
  selectedProfileId = id;
  renderProfilesList();
  
  const p = currentProfiles.find(x => x.id === id);
  if (!p) return;

  document.getElementById('formTitle').textContent = `Edit Profil: ${p.name}`;
  document.getElementById('profileId').value = p.id;
  document.getElementById('paramName').value = p.name;
  document.getElementById('paramDetectionType').value = p.detectionType || 'contour';
  document.getElementById('paramMinArea').value = p.minArea || 500;
  document.getElementById('paramMaxArea').value = p.maxArea || 100000;
  document.getElementById('paramThreshold').value = p.thresholdValue || 128;
  document.getElementById('paramBlur').value = p.blurKernel || 5;
  
  updateSliderDisplay();

  // Badge & Actions
  const badge = document.getElementById('activeStatusBadge');
  const actBtn = document.getElementById('activateBtn');
  const delBtn = document.getElementById('deleteProfileBtn');

  if (p.isActive) {
    badge.classList.remove('hidden');
    actBtn.classList.add('hidden');
  } else {
    badge.classList.add('hidden');
    actBtn.classList.remove('hidden');
  }
  delBtn.classList.remove('hidden');
}

function createNewProfileForm() {
  selectedProfileId = null;
  renderProfilesList();
  
  document.getElementById('formTitle').textContent = 'Buat Profil Kalibrasi Baru';
  document.getElementById('profileForm').reset();
  document.getElementById('profileId').value = '';
  document.getElementById('paramName').value = `Kalibrasi Baru (${new Date().toLocaleTimeString('id-ID', {hour: '2-digit', minute:'2-digit'})})`;
  
  updateSliderDisplay();

  document.getElementById('activeStatusBadge').classList.add('hidden');
  document.getElementById('activateBtn').classList.add('hidden');
  document.getElementById('deleteProfileBtn').classList.add('hidden');
}

document.getElementById('profileForm').addEventListener('submit', async (e) => {
  e.preventDefault();
  const formData = new FormData(e.target);
  const data = Object.fromEntries(formData);
  const prodId = document.getElementById('selectedProductId').value;
  const id = data.id;
  delete data.id;
  delete data.productId;

  try {
    if (id) {
      await api.put(`/api/detection-profiles/${id}`, data);
      showToast('Profil kalibrasi diperbarui', 'success');
    } else {
      await api.post(`/api/products/${prodId}/detection-profiles`, data);
      showToast('Profil kalibrasi baru berhasil dibuat', 'success');
    }
    loadProfilesForProduct(prodId);
  } catch (err) {
    showToast(err.message || 'Gagal menyimpan kalibrasi', 'error');
  }
});

async function activateCurrentProfile() {
  if (!selectedProfileId) return;
  try {
    await api.post(`/api/detection-profiles/${selectedProfileId}/activate`);
    showToast('Profil kalibrasi diaktifkan', 'success');
    loadProfilesForProduct(document.getElementById('selectedProductId').value);
  } catch (err) {
    showToast(err.message || 'Gagal mengaktifkan profil', 'error');
  }
}

async function deleteCurrentProfile() {
  if (!selectedProfileId || !confirm('Hapus profil kalibrasi ini?')) return;
  try {
    await api.delete(`/api/detection-profiles/${selectedProfileId}`);
    showToast('Profil dihapus', 'success');
    loadProfilesForProduct(document.getElementById('selectedProductId').value);
  } catch (err) {
    showToast(err.message || 'Gagal menghapus profil', 'error');
  }
}

init();
</script>
