<div class="space-y-6">
  <!-- Header -->
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <div>
      <h1 class="text-2xl font-bold text-slate-900">Audit Log Sistem</h1>
      <p class="text-slate-600">Catatan aktivitas sensitif dan riwayat tindakan pengguna untuk keamanan</p>
    </div>
    <button onclick="loadLogs(1)" class="inline-flex items-center gap-2 px-4 py-2 bg-white border border-slate-200 text-slate-700 font-semibold rounded-xl hover:bg-slate-50 transition-all text-sm shadow-sm">
      <i data-lucide="refresh-cw" class="w-4 h-4 text-primary-600"></i>
      Segarkan Log
    </button>
  </div>

  <!-- Filters -->
  <div class="bg-white rounded-xl border border-slate-100 p-4">
    <div class="flex flex-col sm:flex-row gap-4">
      <input type="text" id="actionFilter" placeholder="Filter by action (misal: create, update, delete, login)..." class="flex-1 px-4 py-2 bg-slate-50 border border-slate-200 rounded-lg text-sm focus:ring-2 focus:ring-primary-500" oninput="debounceLoad()">
      <select id="resourceFilter" class="px-4 py-2 bg-slate-50 border border-slate-200 rounded-lg text-sm focus:ring-2 focus:ring-primary-500" onchange="loadLogs(1)">
        <option value="">Semua Tipe Resor (Resource)</option>
        <option value="user">User</option>
        <option value="product">Product</option>
        <option value="warehouse">Warehouse</option>
        <option value="category">Category</option>
        <option value="inventory">Inventory</option>
        <option value="scan">Scan Session</option>
        <option value="opname">Stock Opname</option>
      </select>
    </div>
  </div>

  <!-- Logs Table -->
  <div class="bg-white rounded-2xl border border-slate-100 overflow-hidden shadow-sm">
    <div class="overflow-x-auto">
      <table class="w-full">
        <thead class="bg-slate-50 border-b border-slate-200">
          <tr>
            <th class="px-6 py-3.5 text-left text-xs font-semibold text-slate-600 uppercase tracking-wider">Waktu</th>
            <th class="px-6 py-3.5 text-left text-xs font-semibold text-slate-600 uppercase tracking-wider">Pengguna</th>
            <th class="px-6 py-3.5 text-left text-xs font-semibold text-slate-600 uppercase tracking-wider">Tindakan (Action)</th>
            <th class="px-6 py-3.5 text-left text-xs font-semibold text-slate-600 uppercase tracking-wider">Resor & ID</th>
            <th class="px-6 py-3.5 text-left text-xs font-semibold text-slate-600 uppercase tracking-wider">Alamat IP & Perangkat</th>
          </tr>
        </thead>
        <tbody id="logsTableBody" class="divide-y divide-slate-100">
          <tr><td colspan="5" class="px-6 py-12 text-center text-slate-400">Memuat log audit...</td></tr>
        </tbody>
      </table>
    </div>

    <!-- Pagination -->
    <div id="pagination" class="hidden px-6 py-4 border-t border-slate-100 items-center justify-between bg-slate-50/50">
      <p class="text-xs text-slate-500">Menampilkan <span id="showingCount">0</span> dari <span id="totalCount">0</span> log</p>
      <div class="flex gap-2" id="paginationButtons"></div>
    </div>
  </div>
</div>

<script>
let currentPage = 1;
let debounceTimer;

function debounceLoad() {
  clearTimeout(debounceTimer);
  debounceTimer = setTimeout(() => loadLogs(1), 400);
}

async function loadLogs(page = 1) {
  currentPage = page;
  const action = document.getElementById('actionFilter')?.value || '';
  const resourceType = document.getElementById('resourceFilter')?.value || '';

  const params = new URLSearchParams({ page, limit: 20 });
  if (action) params.append('action', action);
  if (resourceType) params.append('resourceType', resourceType);

  try {
    const res = await api.get(`/api/audit-logs?${params}`);
    renderLogs(res.logs || []);
    renderPagination(res.pagination || {});
  } catch (err) {
    showToast('Gagal memuat log audit', 'error');
  }
}

function getActionBadgeHtml(action) {
  const lower = action.toLowerCase();
  if (lower.includes('delete') || lower.includes('remove') || lower.includes('reject')) {
    return `<span class="px-2 py-0.5 rounded font-mono text-[10px] font-bold bg-red-100 text-red-700 uppercase">${action}</span>`;
  } else if (lower.includes('create') || lower.includes('add') || lower.includes('approve') || lower.includes('register')) {
    return `<span class="px-2 py-0.5 rounded font-mono text-[10px] font-bold bg-green-100 text-green-700 uppercase">${action}</span>`;
  } else if (lower.includes('update') || lower.includes('edit') || lower.includes('change')) {
    return `<span class="px-2 py-0.5 rounded font-mono text-[10px] font-bold bg-blue-100 text-blue-700 uppercase">${action}</span>`;
  }
  return `<span class="px-2 py-0.5 rounded font-mono text-[10px] font-bold bg-slate-100 text-slate-700 uppercase">${action}</span>`;
}

function renderLogs(logs) {
  const tbody = document.getElementById('logsTableBody');
  if (!logs.length) {
    tbody.innerHTML = '<tr><td colspan="5" class="px-6 py-12 text-center text-slate-400">Belum ada aktivitas log audit tercatat</td></tr>';
    return;
  }

  tbody.innerHTML = logs.map(l => `
    <tr class="hover:bg-slate-50/80 transition-colors text-xs">
      <td class="px-6 py-3.5 font-mono text-slate-500 whitespace-nowrap">${new Date(l.createdAt).toLocaleString('id-ID')}</td>
      <td class="px-6 py-3.5">
        <p class="font-bold text-slate-800">${l.user?.name || 'Sistem'}</p>
        <p class="text-[10px] text-slate-400 font-mono">${l.user?.email || '-'}</p>
      </td>
      <td class="px-6 py-3.5 whitespace-nowrap">
        ${getActionBadgeHtml(l.action)}
      </td>
      <td class="px-6 py-3.5 font-mono">
        <span class="font-semibold text-slate-700 uppercase">${l.resourceType}</span>
        ${l.resourceId ? `<span class="text-slate-400 ml-1">#${l.resourceId}</span>` : ''}
      </td>
      <td class="px-6 py-3.5">
        <p class="font-mono text-slate-600">${l.ipAddress || '127.0.0.1'}</p>
        <p class="text-[10px] text-slate-400 truncate max-w-xs" title="${l.userAgent || ''}">${l.userAgent || '-'}</p>
      </td>
    </tr>
  `).join('');
}

function renderPagination(pagination) {
  const pag = document.getElementById('pagination');
  if (!pagination.total) {
    pag.classList.add('hidden');
    return;
  }
  pag.classList.remove('hidden');
  pag.classList.add('flex');
  document.getElementById('showingCount').textContent = Math.min(pagination.page * pagination.limit, pagination.total);
  document.getElementById('totalCount').textContent = pagination.total;

  const container = document.getElementById('paginationButtons');
  let html = '';
  for (let i = 1; i <= (pagination.pages || 1); i++) {
    html += `<button onclick="loadLogs(${i})" class="px-3 py-1 text-xs rounded-lg ${i === pagination.page ? 'bg-primary-500 text-white font-bold' : 'bg-white border border-slate-200 text-slate-600 hover:bg-slate-100'}">${i}</button>`;
  }
  container.innerHTML = html;
}

loadLogs(1);
</script>
