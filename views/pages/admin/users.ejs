<div class="space-y-6">
  <!-- Header -->
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <div>
      <h1 class="text-2xl font-bold text-slate-900">Manajemen Pengguna</h1>
      <p class="text-slate-600">Kelola akun staf, manajer, dan administrator organisasi Anda</p>
    </div>
    <button onclick="openModal('addUser')" class="inline-flex items-center gap-2 px-4 py-2 bg-gradient-to-r from-primary-500 to-accent-500 text-white font-semibold rounded-xl shadow-lg shadow-primary-500/30 hover:shadow-xl transition-all">
      <i data-lucide="user-plus" class="w-5 h-5"></i>
      Tambah Pengguna
    </button>
  </div>

  <!-- Users Grid / Table -->
  <div id="usersContainer" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    <div class="col-span-full bg-white rounded-2xl border border-slate-100 p-12 text-center">
      <div class="w-8 h-8 border-4 border-primary-500 border-t-transparent rounded-full animate-spin mx-auto mb-4"></div>
      <p class="text-slate-500">Memuat data pengguna...</p>
    </div>
  </div>
</div>

<!-- Add User Modal -->
<div id="addUserModal" class="fixed inset-0 bg-black/50 z-50 hidden items-center justify-center p-4">
  <div class="bg-white rounded-2xl w-full max-w-md animate-scale-in">
    <div class="p-6 border-b border-slate-100 flex items-center justify-between">
      <h2 class="text-xl font-bold text-slate-900">Tambah Akun Baru</h2>
      <button onclick="closeModal('addUser')" class="p-2 hover:bg-slate-100 rounded-lg transition-colors">
        <i data-lucide="x" class="w-5 h-5"></i>
      </button>
    </div>
    <form id="addUserForm" class="p-6 space-y-4">
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1">Nama Lengkap *</label>
        <input type="text" name="name" required placeholder="John Doe" class="w-full px-4 py-2 border border-slate-200 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500">
      </div>
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1">Email *</label>
        <input type="email" name="email" required placeholder="nama@perusahaan.com" class="w-full px-4 py-2 border border-slate-200 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500">
      </div>
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1">Password Sementara *</label>
        <input type="password" name="password" required placeholder="Min. 8 karakter" class="w-full px-4 py-2 border border-slate-200 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500">
      </div>
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1">Peran (Role) *</label>
        <select name="role" required class="w-full px-4 py-2 border border-slate-200 rounded-lg focus:ring-2 focus:ring-primary-500">
          <option value="staff">Staff (Operasional Gudang & Scan)</option>
          <option value="manager">Manager (Manajemen Stok & Opname)</option>
          <option value="admin">Admin (Akses Penuh)</option>
        </select>
      </div>
      <div class="flex gap-3 pt-4">
        <button type="button" onclick="closeModal('addUser')" class="flex-1 px-4 py-2 border border-slate-200 text-slate-700 font-medium rounded-lg hover:bg-slate-50 transition-colors">Batal</button>
        <button type="submit" class="flex-1 px-4 py-2 bg-primary-500 text-white font-medium rounded-lg hover:bg-primary-600 transition-colors">Simpan</button>
      </div>
    </form>
  </div>
</div>

<!-- Edit User Modal -->
<div id="editUserModal" class="fixed inset-0 bg-black/50 z-50 hidden items-center justify-center p-4">
  <div class="bg-white rounded-2xl w-full max-w-md animate-scale-in">
    <div class="p-6 border-b border-slate-100 flex items-center justify-between">
      <h2 class="text-xl font-bold text-slate-900">Edit Pengguna</h2>
      <button onclick="closeModal('editUser')" class="p-2 hover:bg-slate-100 rounded-lg transition-colors">
        <i data-lucide="x" class="w-5 h-5"></i>
      </button>
    </div>
    <form id="editUserForm" class="p-6 space-y-4">
      <input type="hidden" name="id">
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1">Nama Lengkap *</label>
        <input type="text" name="name" required class="w-full px-4 py-2 border border-slate-200 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500">
      </div>
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1">Email *</label>
        <input type="email" name="email" required class="w-full px-4 py-2 border border-slate-200 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500">
      </div>
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1">Peran (Role) *</label>
        <select name="role" required class="w-full px-4 py-2 border border-slate-200 rounded-lg focus:ring-2 focus:ring-primary-500">
          <option value="staff">Staff</option>
          <option value="manager">Manager</option>
          <option value="admin">Admin</option>
        </select>
      </div>
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1">Status Akun *</label>
        <select name="status" required class="w-full px-4 py-2 border border-slate-200 rounded-lg focus:ring-2 focus:ring-primary-500">
          <option value="active">Aktif</option>
          <option value="inactive">Nonaktif</option>
          <option value="suspended">Suspended (Ditangguhkan)</option>
        </select>
      </div>
      <div class="flex gap-3 pt-4">
        <button type="button" onclick="closeModal('editUser')" class="flex-1 px-4 py-2 border border-slate-200 text-slate-700 font-medium rounded-lg hover:bg-slate-50 transition-colors">Batal</button>
        <button type="submit" class="flex-1 px-4 py-2 bg-primary-500 text-white font-medium rounded-lg hover:bg-primary-600 transition-colors">Update</button>
      </div>
    </form>
  </div>
</div>

<script>
let usersList = [];

async function loadUsers() {
  try {
    const res = await api.get('/api/users');
    usersList = res.users || [];
    renderUsers();
  } catch (err) {
    showToast('Gagal memuat data pengguna', 'error');
  }
}

function getRoleBadgeHtml(role) {
  const map = {
    admin: '<span class="px-2.5 py-1 text-xs font-bold rounded-full bg-purple-100 text-purple-700">ADMIN</span>',
    manager: '<span class="px-2.5 py-1 text-xs font-bold rounded-full bg-blue-100 text-blue-700">MANAGER</span>',
    staff: '<span class="px-2.5 py-1 text-xs font-bold rounded-full bg-green-100 text-green-700">STAFF</span>'
  };
  return map[role] || `<span class="px-2 py-1 text-xs font-bold rounded bg-slate-100">${role}</span>`;
}

function getStatusBadgeHtml(status) {
  const map = {
    active: '<span class="px-2 py-0.5 text-[10px] font-semibold rounded bg-green-100 text-green-700">Aktif</span>',
    inactive: '<span class="px-2 py-0.5 text-[10px] font-semibold rounded bg-slate-100 text-slate-600">Nonaktif</span>',
    suspended: '<span class="px-2 py-0.5 text-[10px] font-semibold rounded bg-red-100 text-red-700">Suspended</span>'
  };
  return map[status] || `<span class="px-2 py-0.5 text-[10px] rounded bg-slate-100">${status}</span>`;
}

function renderUsers() {
  const container = document.getElementById('usersContainer');
  if (!usersList.length) {
    container.innerHTML = `
      <div class="col-span-full bg-white rounded-2xl border border-slate-100 p-12 text-center">
        <i data-lucide="users" class="w-16 h-16 text-slate-300 mx-auto mb-4"></i>
        <h3 class="text-lg font-bold text-slate-700 mb-1">Belum Ada Pengguna Lain</h3>
        <p class="text-sm text-slate-500 max-w-md mx-auto mb-6">Undang staf atau manajer untuk bergabung mengelola inventaris.</p>
      </div>`;
    lucide.createIcons();
    return;
  }

  container.innerHTML = usersList.map(u => `
    <div class="gsap-reveal bg-white rounded-2xl border border-slate-100 p-6 card-hover flex flex-col justify-between space-y-4">
      <div class="flex items-start justify-between">
        <div class="flex items-center gap-3">
          <div class="w-12 h-12 bg-gradient-to-br from-primary-500 to-accent-500 rounded-2xl flex items-center justify-center text-white font-bold text-lg shadow-md shadow-primary-500/20">
            ${u.name.charAt(0).toUpperCase()}
          </div>
          <div>
            <h3 class="font-bold text-slate-900">${u.name}</h3>
            <p class="text-xs text-slate-500 font-mono">${u.email}</p>
          </div>
        </div>
        <div>
          ${getRoleBadgeHtml(u.role)}
        </div>
      </div>

      <div class="flex items-center justify-between text-xs pt-2 border-t border-slate-100">
        <div class="flex items-center gap-2">
          <span>Status:</span>
          ${getStatusBadgeHtml(u.status)}
        </div>
        <span class="text-slate-400">Login: ${u.lastLoginAt ? new Date(u.lastLoginAt).toLocaleDateString('id-ID') : 'Belum pernah'}</span>
      </div>

      <div class="pt-3 border-t border-slate-100 flex justify-end gap-2">
        <button onclick="openEditUser(${u.id}, '${u.name}', '${u.email}', '${u.role}', '${u.status}')" class="px-3 py-1.5 bg-slate-100 hover:bg-primary-50 hover:text-primary-600 rounded-lg text-xs font-semibold text-slate-700 transition-all flex items-center gap-1">
          <i data-lucide="edit" class="w-3.5 h-3.5"></i> Edit
        </button>
        <button onclick="deleteUser(${u.id})" class="p-1.5 text-slate-400 hover:text-red-600 hover:bg-red-50 rounded-lg transition-colors" title="Hapus Akun">
          <i data-lucide="trash-2" class="w-4 h-4"></i>
        </button>
      </div>
    </div>
  `).join('');
  lucide.createIcons();
}

function openModal(type) {
  document.getElementById(`${type}Modal`).classList.remove('hidden');
  document.getElementById(`${type}Modal`).classList.add('flex');
}

function closeModal(type) {
  document.getElementById(`${type}Modal`).classList.add('hidden');
  document.getElementById(`${type}Modal`).classList.remove('flex');
  if (document.getElementById(`${type}Form`)) document.getElementById(`${type}Form`).reset();
}

function openEditUser(id, name, email, role, status) {
  const form = document.getElementById('editUserForm');
  form.querySelector('[name="id"]').value = id;
  form.querySelector('[name="name"]').value = name;
  form.querySelector('[name="email"]').value = email;
  form.querySelector('[name="role"]').value = role;
  form.querySelector('[name="status"]').value = status;
  openModal('editUser');
}

document.getElementById('addUserForm').addEventListener('submit', async (e) => {
  e.preventDefault();
  const formData = new FormData(e.target);
  const data = Object.fromEntries(formData);
  try {
    await api.post('/api/users', data);
    showToast('Pengguna berhasil ditambahkan', 'success');
    closeModal('addUser');
    loadUsers();
  } catch (err) {
    showToast(err.message || 'Gagal menambah pengguna', 'error');
  }
});

document.getElementById('editUserForm').addEventListener('submit', async (e) => {
  e.preventDefault();
  const formData = new FormData(e.target);
  const data = Object.fromEntries(formData);
  const id = data.id;
  delete data.id;
  try {
    await api.put(`/api/users/${id}`, data);
    showToast('Pengguna berhasil diperbarui', 'success');
    closeModal('editUser');
    loadUsers();
  } catch (err) {
    showToast(err.message || 'Gagal memperbarui pengguna', 'error');
  }
});

async function deleteUser(id) {
  if (!confirm('Yakin ingin menghapus pengguna ini?')) return;
  try {
    await api.delete(`/api/users/${id}`);
    showToast('Pengguna berhasil dihapus', 'success');
    loadUsers();
  } catch (err) {
    showToast(err.message || 'Gagal menghapus pengguna', 'error');
  }
}

loadUsers();
</script>
