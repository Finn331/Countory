<div class="space-y-6">
  <!-- Header -->
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <div>
      <div class="flex items-center gap-3">
        <h1 class="text-2xl font-bold text-slate-900">Notifikasi</h1>
        <span id="unreadBadge" class="px-2.5 py-0.5 bg-red-500 text-white font-bold text-xs rounded-full hidden">0 Belum Dibaca</span>
      </div>
      <p class="text-slate-600">Pemberitahuan stok rendah, aktivitas sistem, dan peringatan keamanan</p>
    </div>
    <button onclick="markAllAsRead()" id="markAllBtn" class="inline-flex items-center gap-2 px-4 py-2 bg-white border border-slate-200 text-slate-700 font-semibold rounded-xl hover:bg-slate-50 transition-all text-sm shadow-sm">
      <i data-lucide="check-check" class="w-4 h-4 text-primary-600"></i>
      Tandai Semua Sudah Dibaca
    </button>
  </div>

  <!-- Filter Buttons -->
  <div class="flex gap-2 border-b border-slate-200 pb-3">
    <button onclick="filterNotifs('all')" id="filterBtn-all" class="px-4 py-1.5 bg-primary-500 text-white font-semibold text-xs rounded-lg transition-all">Semua</button>
    <button onclick="filterNotifs('unread')" id="filterBtn-unread" class="px-4 py-1.5 bg-slate-100 text-slate-600 hover:bg-slate-200 font-semibold text-xs rounded-lg transition-all">Belum Dibaca</button>
  </div>

  <!-- Notifications List -->
  <div id="notificationsContainer" class="space-y-3">
    <div class="bg-white rounded-2xl border border-slate-100 p-12 text-center">
      <div class="w-8 h-8 border-4 border-primary-500 border-t-transparent rounded-full animate-spin mx-auto mb-4"></div>
      <p class="text-slate-500">Memuat notifikasi...</p>
    </div>
  </div>
</div>

<script>
let allNotifications = [];
let currentFilter = 'all';

async function loadNotifications() {
  try {
    const res = await api.get('/api/notifications');
    allNotifications = res.notifications || [];
    
    const unreadCount = res.unreadCount || allNotifications.filter(n => !n.isRead).length;
    const badge = document.getElementById('unreadBadge');
    const markBtn = document.getElementById('markAllBtn');

    if (unreadCount > 0) {
      badge.textContent = `${unreadCount} Belum Dibaca`;
      badge.classList.remove('hidden');
      markBtn.disabled = false;
      markBtn.classList.remove('opacity-50', 'cursor-not-allowed');
    } else {
      badge.classList.add('hidden');
      markBtn.disabled = true;
      markBtn.classList.add('opacity-50', 'cursor-not-allowed');
    }

    renderNotifications();
  } catch (err) {
    showToast('Gagal memuat notifikasi', 'error');
  }
}

function filterNotifs(filter) {
  currentFilter = filter;
  const btnAll = document.getElementById('filterBtn-all');
  const btnUnread = document.getElementById('filterBtn-unread');
  
  if (filter === 'all') {
    btnAll.className = 'px-4 py-1.5 bg-primary-500 text-white font-semibold text-xs rounded-lg transition-all';
    btnUnread.className = 'px-4 py-1.5 bg-slate-100 text-slate-600 hover:bg-slate-200 font-semibold text-xs rounded-lg transition-all';
  } else {
    btnUnread.className = 'px-4 py-1.5 bg-primary-500 text-white font-semibold text-xs rounded-lg transition-all';
    btnAll.className = 'px-4 py-1.5 bg-slate-100 text-slate-600 hover:bg-slate-200 font-semibold text-xs rounded-lg transition-all';
  }

  renderNotifications();
}

function renderNotifications() {
  const container = document.getElementById('notificationsContainer');
  const filtered = currentFilter === 'unread' ? allNotifications.filter(n => !n.isRead) : allNotifications;

  if (!filtered.length) {
    container.innerHTML = `
      <div class="bg-white rounded-2xl border border-slate-100 p-12 text-center">
        <i data-lucide="bell-off" class="w-16 h-16 text-slate-300 mx-auto mb-4"></i>
        <h3 class="text-lg font-bold text-slate-700 mb-1">Belum Ada Notifikasi</h3>
        <p class="text-sm text-slate-500">Pemberitahuan stok rendah atau aktivitas penting akan muncul di sini.</p>
      </div>`;
    lucide.createIcons();
    return;
  }

  container.innerHTML = filtered.map(n => {
    const iconMap = {
      warning: { icon: 'alert-triangle', bg: 'bg-yellow-100', text: 'text-yellow-600', border: 'border-yellow-200' },
      error: { icon: 'x-circle', bg: 'bg-red-100', text: 'text-red-600', border: 'border-red-200' },
      success: { icon: 'check-circle', bg: 'bg-green-100', text: 'text-green-600', border: 'border-green-200' },
      info: { icon: 'info', bg: 'bg-blue-100', text: 'text-blue-600', border: 'border-blue-200' }
    };
    const style = iconMap[n.type] || iconMap.info;

    return `
      <div class="gsap-reveal bg-white rounded-2xl border ${n.isRead ? 'border-slate-100 opacity-75' : style.border + ' bg-gradient-to-r from-white via-white to-primary-50/20 shadow-sm'} p-5 flex items-start justify-between gap-4 transition-all">
        <div class="flex items-start gap-4">
          <div class="w-12 h-12 ${style.bg} rounded-2xl flex items-center justify-center flex-shrink-0 mt-0.5">
            <i data-lucide="${style.icon}" class="w-6 h-6 ${style.text}"></i>
          </div>
          <div>
            <div class="flex items-center gap-2">
              <h4 class="font-bold text-sm text-slate-900">${n.title}</h4>
              ${!n.isRead ? '<span class="w-2 h-2 bg-primary-500 rounded-full animate-pulse"></span>' : ''}
            </div>
            <p class="text-xs text-slate-600 mt-1 leading-relaxed">${n.message}</p>
            <span class="text-[10px] text-slate-400 font-mono mt-2 block">${new Date(n.createdAt).toLocaleString('id-ID')}</span>
          </div>
        </div>
        
        <div class="flex items-center gap-2">
          ${!n.isRead ? `
            <button onclick="markAsRead(${n.id})" class="p-2 bg-primary-50 hover:bg-primary-500 text-primary-600 hover:text-white rounded-xl text-xs font-semibold transition-all flex items-center gap-1" title="Tandai Sudah Dibaca">
              <i data-lucide="check" class="w-4 h-4"></i>
            </button>
          ` : `
            <span class="text-[10px] text-slate-400 font-medium px-2 py-1 bg-slate-50 rounded-lg">Dibaca</span>
          `}
        </div>
      </div>
    `;
  }).join('');
  lucide.createIcons();
}

async function markAsRead(id) {
  try {
    await api.patch(`/api/notifications/${id}/read`);
    const idx = allNotifications.findIndex(n => n.id === id);
    if (idx >= 0) allNotifications[idx].isRead = true;
    renderNotifications();
    showToast('Notifikasi ditandai dibaca', 'success');
  } catch (err) {
    showToast('Gagal menandai notifikasi', 'error');
  }
}

async function markAllAsRead() {
  try {
    await api.patch('/api/notifications/read-all');
    allNotifications.forEach(n => n.isRead = true);
    renderNotifications();
    document.getElementById('unreadBadge').classList.add('hidden');
    document.getElementById('markAllBtn').disabled = true;
    document.getElementById('markAllBtn').classList.add('opacity-50', 'cursor-not-allowed');
    showToast('Semua notifikasi ditandai dibaca', 'success');
  } catch (err) {
    showToast('Gagal menandai notifikasi', 'error');
  }
}

loadNotifications();
</script>
